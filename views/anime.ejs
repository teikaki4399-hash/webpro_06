<!Doctype html>
<html>
<head>
  <meta charset="utf-8">
  <title>アニメ一覧</title>
</head>
<body>
  <h2>好きなアニメ一覧</h2>
  <table border="1">
    <tr><th>ID</th><th>タイトル</th><th>放送開始年</th><th>制作会社</th></tr>
    <% for( let row of data ) { %>
      <tr>
        <td><%= row.id %></td>
        <td><%= row.title %></td>
        <td><%= row.year %></td>
        <td><%= row.studio %></td>
      </tr>
    <% } %>
  </table>
  <p><a href="/public/anime_add.html">アニメを追加する</a></p>
</body>
</html>
